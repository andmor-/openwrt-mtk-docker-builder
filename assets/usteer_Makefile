include $(TOPDIR)/rules.mk

PKG_NAME:=usteer
PKG_SOURCE_DATE:=2026-09-20
PKG_SOURCE_VERSION:=59b91bac3389b0e64a9d105f3023c2669e594aa7
PKG_RELEASE:=2

PKG_VERSION:=$(subst -,.,$(PKG_SOURCE_DATE))~$(shell echo $(PKG_SOURCE_VERSION) | cut -c1-8)

PKG_SOURCE_PROTO:=git
PKG_SOURCE_URL:=https://github.com/NilsRo/usteer-ng.git
PKG_MIRROR_HASH:=e7fdc94c21ec2eb105cc5364a27f71d620821ce0066c2b46bbccf39a39306ce0

PKG_BUILD_DIR:=$(BUILD_DIR)/$(PKG_NAME)-$(PKG_VERSION)

PKG_MAINTAINER:=David Bauer <mail@david-bauer.net>
PKG_LICENSE:=GPL-2.0-only

PKG_BUILD_DEPENDS:=libpcap

include $(INCLUDE_DIR)/package.mk
include $(INCLUDE_DIR)/cmake.mk

define Package/usteer
  SECTION:=net
  CATEGORY:=Network
  DEPENDS:=+libubox +libubus +libblobmsg-json +libnl-tiny
  TITLE:=OpenWrt AP roaming assist daemon (usteer-ng fork)
endef

define Package/usteer/conffiles
/etc/config/usteer
endef

define Package/usteer/install
	$(INSTALL_DIR) $(1)/sbin $(1)/etc/init.d $(1)/etc/config
	$(CP) $(PKG_BUILD_DIR)/openwrt/usteer-ng/files/etc/config/usteer $(1)/etc/config/usteer
	$(INSTALL_BIN) $(PKG_BUILD_DIR)/openwrt/usteer-ng/files/etc/init.d/usteer $(1)/etc/init.d/usteer
	$(INSTALL_BIN) $(PKG_INSTALL_DIR)/usr/sbin/usteerd $(1)/sbin/usteerd
endef

$(eval $(call BuildPackage,usteer))
